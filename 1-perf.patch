+    app.snd[perfect ? 'bonus' : 'brick'](this.stack.length);
+    const y = this.levelY(this.stack.length - 1);
+    this.fx.burst(nx + nw / 2, y, perfect ? 30 : 10, { color: perfect ? ['#fff', '#ffd36b'] : [`hsl(${m.hue},90%,65%)`], min: 80, max: 360, gravity: 500 });
