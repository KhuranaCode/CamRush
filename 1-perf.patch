+      const m = this.mv; m.x += this.dir * -1 * m.speed * dt;
+      // bounce on screen edges
+      if (m.x < -m.w * 0.6) { this.dir = -1; m.x = -m.w * 0.6; } else if (m.x > W - m.w * 0.4) { this.dir = 1; m.x = W - m.w * 0.4; }
