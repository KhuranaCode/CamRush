+const COLS = ['#ff4f7b', '#00e0ff', '#ffd36b', '#7dff6a', '#b18cff'];
+export default class SkyJuggle {
+  static meta = {
+    id: 'juggle', name: 'Sky Juggle', tagline: 'Bat the balloons back up with your hands. Three misses and it is over.', control: '🖐 Both hands',
