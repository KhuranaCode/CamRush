+      const cutX = m.x < top.x ? m.x : r, cutW = m.w - ov;
+      this.debris.push({ x: cutX, w: cutW, y: this.levelY(this.stack.length), vy: 0, vx: (m.x < top.x ? -1 : 1) * 80, hue: m.hue, rot: 0 });
+    }
